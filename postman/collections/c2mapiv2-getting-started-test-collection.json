              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [],
              "raw": "{{baseUrl}}/static"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"docSourceAll\": {\n    \"requestId\": 16499,\n    \"filename\": \"document.pdf\"\n  },\n  \"recipientAddressSource\": {\n    \"firstName\": \"Bryan\",\n    \"lastName\": \"Payne\",\n    \"address1\": \"6434 Ronald Points\",\n    \"city\": \"Melissaton\",\n    \"state\": \"DE\",\n    \"zip\": \"26669\",\n    \"country\": \"USA\",\n    \"address2\": \"Suite 100\",\n    \"address3\": \"\",\n    \"foo1\": \"Custom Field 1\",\n    \"foo2\": \"Custom Field 2\"\n  },\n  \"jobTemplate\": \"standard_letter\",\n  \"returnAddress\": {\n    \"firstName\": \"Melinda\",\n    \"lastName\": \"Gay\",\n    \"address1\": \"78391 Tina Mall Suite 522\",\n    \"address2\": \"Suite 100\",\n    \"address3\": \"\",\n    \"city\": \"West Emily\",\n    \"state\": \"MA\",\n    \"zip\": \"05795\",\n    \"country\": \"USA\"\n  }\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "auth": null
          },
          "response": []
        }
